    "provenance": {
      "technique_id": 1,
      "version": 1,
      "checked_on": "2026-11-02",
      "rules": [
        {
          "id": "sect.horizon",
          "tradition": "Hellenistic",
          "method": "Sun above/below horizon; Sun/Jupiter/Saturn diurnal, Moon/Venus/Mars nocturnal. Mercury uses morning/evening phase.",
          "source": "https://theastrologypodcast.com/transcripts/tap-ep-274-transcript-sect-in-astrology-day-and-night-charts/",
          "author": "Chris Brennan and guests",
          "edition": "Episode 274 transcript",
          "locator": "Day/night teams and sect light",
          "exceptions": [
            "Geometric center horizon threshold is explicit implementation convention; refraction, terrain and a solar-disk convention can change borderline sect."
          ]
        },
        {
          "id": "sect.mercury",
          "tradition": "Robert Hand",
          "method": "Morning Mercury diurnal; evening Mercury nocturnal.",
          "source": "https://theastrologypodcast.com/transcripts/ep-37-robert-hand-on-sect-day-vs-night-charts/",
          "author": "Robert Hand / Chris Brennan",
          "edition": "Episode 37 transcript",
          "locator": "Mercury's two criteria",
          "exceptions": [
            "Hand also discusses an application-based alternative; not implemented. Longitude phase is computed, not actual visibility."
          ]
        },
        {
          "id": "dignities.tables",
          "tradition": "Named historical tables",
          "method": "Domicile, exaltation, triplicity, bounds and ten-degree faces are table lookups; debilities are detriment/fall.",
          "source": "https://www.skyscript.co.uk/essential_dignities.html",
          "author": "William Lilly; Skyscript presentation",
          "edition": "CA 1647, p.104",
          "locator": "Main dignity diagram and separate Egyptian terms diagram",
          "exceptions": [
            "Egyptian and Lilly-Ptolemaic bounds remain distinct. Lilly's table is not identical to all Ptolemy transmissions. Exaltation degree is reported as data; dignity applies throughout its sign."
          ]
        },
        {
          "id": "triplicities.dorothean",
          "tradition": "Dorothean",
          "method": "Day/night priority rulers plus participating ruler; Lilly uses two rulers, with Mars ruling water in both sects.",
          "source": "https://www.skyscript.co.uk/triplicities.html",
          "author": "Deborah Houlding",
          "edition": "Online article",
          "locator": "Ancient Assignment of Triplicity Rulers; nocturnal Scorpio example",
          "examples": [
            "Nocturnal Scorpio: Mars, Venus, Moon in priority order."
          ],
          "exceptions": [
            "Participating rulership is exposed separately; no universal dignity score."
          ]
        },
        {
          "id": "reception.dignities",
          "tradition": "Medieval/traditional reconstruction",
          "method": "The dignity owner receives the visiting planet; mutual reception is reciprocal. Optional aspect-required rule uses sign configuration and major dignity or two minor dignities.",
          "source": "https://www.skyscript.co.uk/dig6.html",
          "author": "Deborah Houlding",
          "edition": "Understanding Dignity, part 6",
          "locator": "Sun at 25 Libra example, paragraphs 12\u00e2\u20ac\u201c19",
          "examples": [
            "Sun at 25 Libra at night: Venus domicile, Saturn exaltation, Mercury triplicity, Mars term, Jupiter face in Lilly tables."
          ],
          "exceptions": [
            "Occupancy, sign-level aspect-required reception and Hellenistic domicile dispositorship are separate policies. No claim to full Bonatti perfection rules."
          ]
        },
        {
          "id": "solar.proximity",
          "tradition": "Lilly and earlier beams convention",
          "method": "CA p.113: same-sign combustion below 8.5 degrees; beams below 17; cazimi within 17 arcminutes. Earlier beams convention: 15 degrees, without medieval combustion/cazimi categories.",
          "source": "https://www.skyscript.co.uk/glossary/combust/",
          "author": "Skyscript glossary citing William Lilly",
          "edition": "CA 1647 pp.113\u00e2\u20ac\u201c114; comparison with p.300",
          "locator": "Combust/Combustion",
          "examples": [
            "Lilly: Sun 15\u00c2\u00b030 Taurus and Venus 15\u00c2\u00b025 Taurus is cazimi."
          ],
          "exceptions": [
            "Lilly p.300 instead uses 12-degree beams and 16-minute cazimi; this conflicting passage is recorded but not merged into CA113. No naked-eye visibility guarantee."
          ]
        },
        {
          "id": "lots.sect-reversing",
          "tradition": "Hellenistic reconstruction",
          "method": "Day Fortune ASC+Moon\u00e2\u02c6\u2019Sun, Spirit ASC+Sun\u00e2\u02c6\u2019Moon; reverse each at night.",
          "source": "https://ncgrastrology.org/wp-content/uploads/publications/geocosmic-journal/NCGR_Geocosmic_Journal_2022_Autumn.pdf",
          "author": "NCGR Geocosmic Journal contributors",
          "edition": "Autumn 2022",
          "locator": "The Hellenistic Lots: Fortune & Spirit, displayed formulas",
          "exceptions": [
            "Fixed-day Fortune is a separate convention; Spirit remains sect-reversing. Lots are symbolic points, not physical bodies."
          ]
        },
        {
          "id": "lots.fixed-fortune",
          "tradition": "Lilly",
          "method": "Fortune uses ASC+Moon\u00e2\u02c6\u2019Sun for day and night.",
          "source": "https://www.skyscript.co.uk/CA/CA_DH.pdf",
          "author": "William Lilly",
          "edition": "Christian Astrology 1647",
          "locator": "p.143, Of the Part of Fortune, and how to take it, either by Day or Night",
          "exceptions": [
            "Spirit is not attributed to Lilly here; its formula remains separately sourced."
          ]
        }
      ],
